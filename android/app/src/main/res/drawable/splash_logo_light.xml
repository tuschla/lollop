<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark for a LIGHT (white) ground: milestone route-trace drawn DARK.
     Geometry from ic_brand_mark (design/icons README, 100x100 grid): start ring
     (never filled), trace, filled goal dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- The Android 12+ SplashScreen masks windowSplashScreenAnimatedIcon to a
         centre circle (~2/3 of the icon area). The mark's geometry spans nearly
         the whole viewport (corners ~90% dia), so it was clipped ("garbled") on
         the launch screen. Scale the art to 0.66 about the viewport centre so it
         sits inside the mask's safe circle. -->
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.66"
        android:scaleY="0.66">
        <path
            android:pathData="M20,80 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0"
            android:strokeColor="#FF111111"
            android:strokeWidth="4.5" />
        <path
            android:pathData="M24,80 C34,52 58,66 66,34"
            android:strokeColor="#FF111111"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M60,26 a10,10 0 1 1 20,0 a10,10 0 1 1 -20,0 Z"
            android:fillColor="#FF111111" />
    </group>
</vector>
