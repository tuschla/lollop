/target

# Built native libs, produced by `cargo ndk`, not source.
/android/app/src/main/jniLibs/

# Local, uncommitted working notes / scratch design references.
*.local.md

# Machine-local cargo config (absolute NDK/SDK paths, not portable).
/.cargo/

# Untracked local project files (instructions, design notes, research KB, planning docs).
/planning/

# Overnight AUR dependency-check logs, scratch output.
aur-check-*.log

# Roborazzi screenshot baselines: local only, recorded with recordRoborazziDebug.
/android/app/src/test/screenshots/
