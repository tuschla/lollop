<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the app writes the widget payload to and the widget extension
	     reads (Shared/SharedContainer.swift). A literal: SideStore reads the group
	     from the signed binary and registers it as group.app.milestone.lollop.<TEAMID>
	     (the CI signs the .ipa ad hoc with this file, .github/workflows/ios-app.yml). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.milestone.lollop</string>
	</array>
</dict>
</plist>
