<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the app writes the widget payload to and the widget extension
	     reads (Shared/SharedContainer.swift). LOLLOP_APP_GROUP is set in
	     iosApp/project.yml; Xcode fills it in when it signs. SideStore reads the group
	     from the signed binary and registers it as <group>.<TEAMID>; the CI signs the
	     unsigned .ipa ad hoc with this file, the group filled in from the built
	     Info.plist (.github/workflows/ios-app.yml). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LOLLOP_APP_GROUP)</string>
	</array>
</dict>
</plist>
