# How the Rust core (the `shared` crate) is built for the apps and their tests.
# Read by the Gradle build (android/build-logic, RustCore) and sourced by
# scripts/build-ios-core.sh, so only KEY=value lines.

# Cargo profile of the core every app binary links (APK, iOS framework).
RUST_PROFILE_APP=release
# Cargo profile of the core tests link: the host JNI library and the C ABI
# staticlib with the lollop_*_for_test hooks.
RUST_PROFILE_TESTS=dev

# Rust triple of each Kotlin/Native target that links the C ABI staticlib.
RUST_TRIPLE_linuxX64=x86_64-unknown-linux-gnu
RUST_TRIPLE_iosArm64=aarch64-apple-ios
RUST_TRIPLE_iosSimulatorArm64=aarch64-apple-ios-sim
