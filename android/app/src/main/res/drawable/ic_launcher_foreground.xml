<?xml version="1.0" encoding="utf-8"?>
<!-- milestone brand mark (design/brand/milestone-appicon-dark.svg): start dot,
     route trace, goal dot. Authored in the SVG's 0..100 space; the group maps
     it into the 108dp adaptive-icon viewport shrunk ~60% toward center so the
     whole mark sits inside the 66dp safe zone (max extent ~29dp of the 33dp
     safe radius). Point mapping: 50 + 0.648*(p - 50) + 4. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.648"
        android:scaleY="0.648"
        android:translateX="4"
        android:translateY="4">
        <!-- start dot: circle cx=24 cy=80 r=4, stroke #000000 w4 -->
        <path
            android:pathData="M20,80 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0 Z"
            android:strokeColor="#000000"
            android:strokeWidth="4" />
        <!-- route trace -->
        <path
            android:pathData="M24,80 C34,52 58,66 66,34"
            android:strokeColor="#000000"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />
        <!-- goal dot: circle cx=70 cy=26 r=9.5 -->
        <path
            android:pathData="M60.5,26 a9.5,9.5 0 1 1 19,0 a9.5,9.5 0 1 1 -19,0 Z"
            android:fillColor="#000000" />
    </group>
</vector>
