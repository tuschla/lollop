<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (widget/TodayWidget.kt). Reuses the Today screen's
     plan and button strings; these are the widget's own. -->
<resources>
    <!-- widget_overline_today is also the name in the widget picker. -->
    <string name="widget_description">Today\'s session, rest day or pause, with its next step and the plan week.</string>

    <string name="widget_overline_today">Today</string>
    <!-- %1$s = "Today", %2$s = the short date the content is for ("Wed, Oct 28"). -->
    <string name="widget_overline_day">%1$s · %2$s</string>
    <!-- Shown instead of the day's content when the stored day is not today (after
         midnight, a time zone or clock change) or nothing is stored yet. -->
    <string name="widget_open_to_update">Open lollo to update</string>
    <string name="widget_rest_day">Rest day</string>
    <string name="widget_no_session">No session today</string>
    <!-- %1$s = next session title, %2$s = its short date ("Thu, Oct 15"). -->
    <string name="widget_next">Next: %1$s, %2$s</string>
    <string name="widget_session_done">Session done</string>
    <!-- A 2×1 widget's short line on a rest day. %1$s = the next session's
         weekday within the week ("Next: Thu"), else its short date ("Next: Thu, Nov 5"). -->
    <string name="widget_next_day">Next: %1$s</string>
    <!-- Under the "Training paused" title: the hold's reason is health detail, so
         the home screen does not show it. -->
    <string name="widget_paused_body">Open lollo for details.</string>
    <!-- Trails a settled plan item: "Squat · Done". -->
    <string name="widget_item_done">Done</string>
    <!-- %1$s = item name, %2$s = its detail or "Done". -->
    <string name="widget_item_line">%1$s · %2$s</string>
    <plurals name="widget_more_items">
        <item quantity="one">%1$d more item</item>
        <item quantity="other">%1$d more items</item>
    </plurals>
    <string name="widget_no_plan">No plan yet</string>
    <string name="widget_no_plan_body">Open lollo to make a plan.</string>
    <string name="widget_setup_title">Not set up yet</string>
    <string name="widget_setup_body">Open lollo to answer the setup questions.</string>
    <string name="widget_open_today_cd">Open Today in lollo</string>

    <!-- Sample session of the widget picker's preview (TodayWidget.providePreview,
         layout/widget_preview.xml). Item lines read like the widget's own. -->
    <string name="widget_preview_title">Upper body</string>
    <string name="widget_preview_lift_1">Bench press</string>
    <string name="widget_preview_lift_1_detail">3×5 @ 60 kg</string>
    <string name="widget_preview_lift_2">Barbell row</string>
    <string name="widget_preview_lift_2_detail">3×8 @ 50 kg</string>
    <string name="widget_preview_lift_3">Overhead press</string>
    <string name="widget_preview_lift_3_detail">3×8 @ 35 kg</string>
</resources>
