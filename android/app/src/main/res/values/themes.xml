<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Post-splash application theme. Edge-to-edge: the status/navigation bars
         are transparent and their icon contrast is set at runtime from the
         RESOLVED palette (MainActivity.onCreate), because a hardcoded
         statusBarColor is ignored on API 35+. windowBackground matches the
         resolved ground so the Compose-load frame doesn't flash the opposite
         color (light = white here; values-night overrides to black). -->
    <style name="Theme.Milestone.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Launch/splash theme (the manifest <application> entry). Uses the
         androidx core-splashscreen API: it paints the pre-Compose launch frame
         with windowSplashScreenBackground + the route-mark icon, then hands off
         to postSplashScreenTheme once installSplashScreen() runs in onCreate.
         Follows the SYSTEM light/dark setting via the values / values-night
         split: light ground + DARK logo here, black ground + WHITE logo in
         values-night. -->
    <style name="Theme.Milestone" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_light</item>
        <item name="postSplashScreenTheme">@style/Theme.Milestone.App</item>
    </style>

    <!-- In-app DarkMode override (Light/Dark) forces one of these from
         MainActivity.onCreate via setTheme(), BEFORE the splash is installed.
         Their splash color + logo are set explicitly (not via a night-qualified
         resource) so they hold regardless of the OS night setting. PLATFORM
         LIMITATION: on API 31+ the cold-start splash is drawn by SystemUI from
         the MANIFEST theme before onCreate can setTheme(), so that entire
         system-drawn splash follows the SYSTEM setting - the override takes
         effect only from the app-drawn frames on (pre-31 splash, warm starts,
         post-splash windowBackground). See MainActivity.onCreate. -->
    <style name="Theme.Milestone.Forced.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_light</item>
        <item name="postSplashScreenTheme">@style/Theme.Milestone.App.Light</item>
    </style>
    <style name="Theme.Milestone.Forced.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Milestone.App.Dark</item>
    </style>

    <!-- Post-splash app themes for the forced variants: pin windowBackground
         explicitly so a forced Light on a dark OS (or vice-versa) still lands on
         the matching ground. -->
    <style name="Theme.Milestone.App.Light" parent="Theme.Milestone.App">
        <item name="android:windowBackground">@color/splash_bg_light</item>
    </style>
    <style name="Theme.Milestone.App.Dark" parent="Theme.Milestone.App">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
    </style>
</resources>
